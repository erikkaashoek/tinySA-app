        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QSpinBox" name="fontSizeSpin">
         <property name="minimum">
          <number>6</number>
         </property>
         <property name="maximum">
          <number>20</number>
         </property>
        </widget>
       </item>
       <item row="4" column="0" colspan="3">
